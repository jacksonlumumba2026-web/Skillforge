# ---- Supabase ----
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google OAuth (configured inside Supabase Auth > Providers > Google) ----
# No separate env vars needed here — client ID/secret are set in the Supabase dashboard.

# ---- M-Pesa (Safaricom Daraja API — STK Push / Lipa Na M-Pesa Online) ----
# https://developer.safaricom.co.ke — create an app to get sandbox keys instantly;
# production keys require a paybill/till number and Safaricom go-live approval.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
# Sandbox shortcode/passkey are published on the Daraja docs (Lipa Na M-Pesa
# Online sandbox credentials); production uses your own paybill/till + passkey.
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Safaricom calls this URL with the payment result — must be a publicly
# reachable HTTPS URL (not localhost). Use a tunnel (ngrok, etc.) for local dev.
MPESA_CALLBACK_URL=https://your-deployed-domain.example.com/api/mpesa/callback

# Plan prices in KES. NEXT_PUBLIC_ because the billing page reads them
# client-side too — keep this file's value and lib/mpesa.ts's server-side
# read in sync (see lib/pricing.ts).
NEXT_PUBLIC_MPESA_PRICE_MONTHLY_KES=2500
NEXT_PUBLIC_MPESA_PRICE_ANNUAL_KES=24000

# ---- YouTube Data API v3 ----
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ---- Anthropic (step summaries + checklists) ----
ANTHROPIC_API_KEY=

# ---- App ----
# Public base URL, used for OAuth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

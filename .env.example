NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only the secret key is needed — the checkout flow redirects to Paystack's
# hosted page (authorization_url) instead of using client-side Paystack JS,
# so no public key is required.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=

# ---- M-Pesa (Safaricom Daraja STK Push) — second payment option ----
# MPESA_ENV=sandbox while testing; set to "production" once your Till is
# live on Daraja. MPESA_TRANSACTION_TYPE defaults to CustomerBuyGoodsOnline
# (Till/Buy Goods) — only set it if you're using a Paybill instead.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# ---- Manual M-Pesa fallback — for while STK Push isn't working ----
# Optional, independent of each other. Each pair that's fully set adds a
# "pay this way, then enter your confirmation code" option that grants
# access immediately (no Daraja API involved — Safaricom has no way to
# auto-verify either of these programmatically). Leave both pairs blank to
# hide manual M-Pesa entirely.
# Personal number (M-Pesa Send Money):
MPESA_MANUAL_NUMBER=
MPESA_MANUAL_NAME=
# Till Number (Lipa na M-Pesa — Buy Goods and Services):
MPESA_TILL_NUMBER=
MPESA_TILL_NAME=

# ---- Daily study reminders (Web Push) ----
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Vercel sends this automatically as "Authorization: Bearer <value>" on
# every cron invocation once it's set as an env var — any random string works.
CRON_SECRET=

# ---- AI course generation (learner-requested courses) ----
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=

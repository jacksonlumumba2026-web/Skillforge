# ---- Supabase ----
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Project Settings > API > service_role (server-only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google OAuth (configured inside Supabase Auth > Providers > Google) ----
# No separate env vars needed here — client ID/secret are set in the Supabase dashboard.

# ---- Stripe ----
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
# Price IDs for the two subscription plans (create in Stripe Dashboard > Products)
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=

# ---- YouTube Data API v3 ----
# https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# ---- Anthropic (step summaries + checklists) ----
ANTHROPIC_API_KEY=

# ---- App ----
# Public base URL, used for Stripe redirect URLs and OAuth callbacks
NEXT_PUBLIC_SITE_URL=http://localhost:3000

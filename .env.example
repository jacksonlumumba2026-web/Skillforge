NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Only the secret key is needed — the checkout flow redirects to Paystack's
# hosted page (authorization_url) instead of using client-side Paystack JS,
# so no public key is required.
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=

# ---- M-Pesa (Safaricom Daraja STK Push) — second payment option ----
# MPESA_ENV=sandbox while testing; set to "production" once your Till is
# live on Daraja. MPESA_TRANSACTION_TYPE defaults to CustomerBuyGoodsOnline
# (Till/Buy Goods) — only set it if you're using a Paybill instead.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline

# ---- Manual M-Pesa fallback — for while Till/PayBill approval is pending ----
# Optional. If both are set, buyers also see a "Send Money to this number,
# then enter your confirmation code" option that grants access immediately
# (no Daraja API involved — Safaricom has no way to auto-verify a payment
# into an ordinary personal number). Leave blank to hide this option.
MPESA_MANUAL_NUMBER=
MPESA_MANUAL_NAME=

# ---- Daily study reminders (Web Push) ----
# Generate a pair with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Vercel sends this automatically as "Authorization: Bearer <value>" on
# every cron invocation once it's set as an env var — any random string works.
CRON_SECRET=

# ---- AI course generation (learner-requested courses) ----
YOUTUBE_API_KEY=
ANTHROPIC_API_KEY=
